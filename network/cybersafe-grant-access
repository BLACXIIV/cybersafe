#!/bin/bash
# cybersafe-grant-access — the ONLY command the app is allowed to run as
# root (see sudoers-cybersafe). Keep this file short and paranoid: it
# strictly validates its own arguments instead of trusting the caller,
# because anything reachable via passwordless sudo is a de-facto part of
# the app's attack surface.
#
# Usage:
#   cybersafe-grant-access grant  <mac> <seconds>   # allow <mac> through the gate for <seconds>
#   cybersafe-grant-access revoke <mac>              # remove <mac> from the gate immediately
set -euo pipefail

SET_NAME="voucher_allow"
MAC_RE='^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'

mode="${1:-}"
mac="${2:-}"

if [[ -z "$mac" || ! "$mac" =~ $MAC_RE ]]; then
    echo "cybersafe-grant-access: invalid or missing MAC address: '${mac}'" >&2
    exit 1
fi
mac_lower="$(echo "$mac" | tr 'A-Z' 'a-z')"

case "$mode" in
    grant)
        seconds="${3:-}"
        if [[ -z "$seconds" || ! "$seconds" =~ ^[0-9]+$ ]] || (( seconds < 1 || seconds > 86400 )); then
            echo "cybersafe-grant-access: invalid duration: '${seconds}' (must be 1-86400 seconds)" >&2
            exit 1
        fi
        /usr/sbin/ipset add "$SET_NAME" "$mac_lower" timeout "$seconds" -exist
        ;;
    revoke)
        /usr/sbin/ipset del "$SET_NAME" "$mac_lower" 2>/dev/null || true
        ;;
    *)
        echo "usage: cybersafe-grant-access {grant|revoke} <mac> [seconds]" >&2
        exit 1
        ;;
esac
