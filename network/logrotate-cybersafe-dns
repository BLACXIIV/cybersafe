/var/log/cybersafe-dns.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    # dnsmasq creates the log with restrictive perms; logrotate's create
    # wins after each rotation. 0644 so the pi-user daemon (and admin app)
    # can read it without group juggling.
    create 0644 dnsmasq adm
    sharedscripts
    postrotate
        # dnsmasq reopens its log file on SIGUSR2 (see the dnsmasq man page,
        # --log-facility); without this it keeps writing to the rotated file.
        systemctl kill --signal=SIGUSR2 dnsmasq.service >/dev/null 2>&1 || true
    endscript
}
